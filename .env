# Copy to .env (Windows: copy .env.example .env). Never commit .env.
# Everything below is optional. The CRM works with none of it set.

# --- Server (localhost only by default) ---
HOST=127.0.0.1
PORT=4000
# Where the SQLite file and backups live. Default: <project>/data
# DATA_DIR=D:\crm-data

# --- Optional AI provider (OpenAI-compatible /chat/completions endpoint) ---
# Leave empty and the AI page shows "AI Not Configured". Local rule-based objection tips still work.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# --- Phase 2: SIP/WebRTC provider (not used by the Phase 1 MVP) ---
# Placeholders only. Use values from YOUR provider's dashboard; do not guess them.
SIP_WS_URL=
SIP_URI=
SIP_AUTH_USER=
SIP_PASSWORD=
